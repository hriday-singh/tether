{
  "name": "tether-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hriday-singh/tether.git"
  },
  "homepage": "https://github.com/hriday-singh/tether#readme",
  "bugs": {
    "url": "https://github.com/hriday-singh/tether/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . && pnpm --filter @tether/web lint",
    "build:pkg": "npm run build:pkg --workspaces --if-present",
    "db:migrate": "pnpm --filter @tether/server db:migrate",
    "build": "npm run typecheck && npm run test && npm run build:pkg",
    "dev": "pnpm --filter @tether/server --filter @tether/web --parallel dev",
    "dev:server": "pnpm --filter @tether/server dev",
    "dev:web": "pnpm --filter @tether/web dev",
    "start:server": "pnpm --filter @tether/server start",
    "chaos:ci": "vitest run --project @tether/chaos",
    "bench": "pnpm --filter @tether/chaos run bench"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^3.0.5"
  }
}
