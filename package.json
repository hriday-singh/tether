{
  "name": "tether-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tests/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build:pkg": "npm run build:pkg --workspaces --if-present",
    "build": "npm run typecheck && npm run test && npm run build:pkg",
    "dev:server": "npm --workspace=@tether/server run dev",
    "start:server": "npm --workspace=@tether/server start",
    "chaos:ci": "vitest run --project @tether/chaos",
    "bench": "pnpm --filter @tether/chaos run bench"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
