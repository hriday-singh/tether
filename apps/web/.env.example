# Web app (Next.js). Copy to .env.local.
# Sync backend: "fake" runs everything in the browser (BroadcastChannel + IndexedDB) until apps/server lands.
NEXT_PUBLIC_SYNC_MODE=fake
# REST + WebSocket base of apps/server (used when NEXT_PUBLIC_SYNC_MODE=server)
NEXT_PUBLIC_API_URL=http://localhost:3000
# Enables Network Lab, Chaos Lab / bot storm
NEXT_PUBLIC_DEMO_MODE=true
