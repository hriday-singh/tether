# Web app (Next.js). Optional: next.config.ts already loads the repo-root .env, so only put overrides here (.env.local).
# REST + WebSocket base of apps/server
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
# Enables Network Lab, Chaos Lab / bot storm
NEXT_PUBLIC_DEMO_MODE=true
# GitHub repository URL
NEXT_PUBLIC_REPO_URL=https://github.com/hriday-singh/tether
