# ==============================================================================
# Server Configuration (apps/server)
# ==============================================================================
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Security (must be at least 32 characters in production)
JWT_SECRET=development_secret_must_be_at_least_32_chars_long!!
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

# Database: SQLite only (embedded via node:sqlite). Postgres is not supported, see docs/06.
DATABASE_DRIVER=sqlite
SQLITE_PATH=./data/tether.db

# Room & Host Timing Limits
HOST_GRACE_MS=5000
PERSIST_FLUSH_MS=250
ROOM_UNLOAD_IDLE_MS=30000

# Reverse Proxy Configuration (0 = direct connection / ignore client X-Forwarded-For; >0 for ALB/Cloudflare/Nginx)
TRUST_PROXY_HOPS=0

# Server Demo Mode (enables bot storm P2 and test endpoints)
DEMO_MODE=true

# ==============================================================================
# Web App Configuration (apps/web)
# ==============================================================================
WEB_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_REPO_URL=https://github.com/hriday-singh/tether

# Comma-separated hostnames Next.js should accept dev HMR/resource requests from
# (e.g. custom domain proxies). Leave empty for localhost-only development.
ALLOWED_DEV_ORIGINS=

# ==============================================================================
# Docker Compose Deployment
# ==============================================================================
SERVER_PORT=4000
WEB_PORT=3000
